# Copy to .env.local and fill in real values for local dev.
# In Vercel, set these in Project Settings → Environment Variables.

# --- Database ---
# Supabase Postgres connection string (pooled, for app) and direct (for migrations)
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres
DIRECT_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGc...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGc...

# Used for HMAC of invite tokens. Generate with: openssl rand -base64 32
AUTH_SECRET=replace-me

# Public URL of the deployed app (used in invite emails and OAuth redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Google OAuth (configured inside Supabase Auth settings) ---
# These are referenced here as documentation only; Supabase manages the actual OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Vercel Blob (receipts, photos, lease PDFs) ---
BLOB_READ_WRITE_TOKEN=

# --- Postmark (transactional email) ---
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=hello@example.com

# --- Web Push (VAPID) ---
# Generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:hello@example.com

# --- DeepL (Phase 2; safe to leave blank for Phase 1) ---
DEEPL_API_KEY=

# --- Cron secret (Vercel cron uses a Bearer token) ---
CRON_SECRET=replace-me
